{
  "name": "bridgestone-cup-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API server for the Bridgestone Cup BP 2026 website",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/app.js && node --check src/server.js",
    "migrate:gallery:r2": "node --env-file-if-exists=.env scripts/migrate-gallery-to-r2.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "serverless-http": "^4.0.0"
  }
}
