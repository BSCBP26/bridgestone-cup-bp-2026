# Use `production` only on the backend hosting provider.
NODE_ENV=development
PORT=3000
# Production example:
# ALLOWED_ORIGINS=https://ekoputranugraha.github.io
# Keep the local origins below for local development.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4173,http://127.0.0.1:4173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback only. Prefer SUPABASE_SECRET_KEY for new Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=

# Media storage. Keep `supabase` until the R2 bucket is ready.
MEDIA_STORAGE_PROVIDER=supabase
# Required only when MEDIA_STORAGE_PROVIDER=r2. Keep all credentials backend-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bridgestone-cup-media
# Production should use an R2 custom domain, for example https://media.example.com
R2_PUBLIC_BASE_URL=
# Public backend `/api` URL used as a media proxy when r2.dev is blocked.
PUBLIC_API_BASE_URL=
